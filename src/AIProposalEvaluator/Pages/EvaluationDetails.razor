@page "/evaluation/{Id}"
@using frontend.Models
@using frontend.Services
@inject IEvaluationService EvaluationService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

@if (Evaluation == null)
{
    <div class="text-center py-5">
        <div class="spinner-dot mx-auto mb-3" style="width: 40px; height: 40px;"></div>
        <h5>Loading Evaluation Report...</h5>
    </div>
}
else
{
    <!-- Page Header & Action Bar -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <button class="btn-secondary py-1 px-2 text-secondary" @onclick='() => NavigationManager.NavigateTo("history")'>
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to History
                </button>
                <span class="badge-pill badge-indigo">ID: @Evaluation.Id</span>
            </div>
            <h3 class="font-weight-extrabold mb-1">@Evaluation.ProposalTitle</h3>
            <div class="small text-secondary d-flex flex-wrap align-items-center gap-3">
                <span><i class="fa-solid fa-user me-1 text-indigo-400"></i> PI: @Evaluation.PrincipalInvestigator</span>
                <span><i class="fa-solid fa-building me-1 text-cyan-400"></i> @Evaluation.Institution</span>
                <span><i class="fa-solid fa-calendar me-1 text-emerald-400"></i> Evaluated: @Evaluation.EvaluatedAt.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button class="btn-primary" @onclick="DownloadReport">
                <i class="fa-solid fa-file-pdf"></i> Download PDF Report (FR-8)
            </button>
        </div>
    </div>

    <!-- Top Score Summary Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4 text-center">
            <div class="glass-card h-100 d-flex flex-column align-items-center justify-content-center">
                <ScoreGauge Score="@Evaluation.OverallScore" />
                <h4 class="mt-3 font-weight-bold">Overall AI Score</h4>
                <span class="badge-pill badge-emerald mt-1">@Evaluation.ScoreTier</span>
                @if (Evaluation.RequestedBudget.HasValue)
                {
                    <div class="small text-muted mt-2">
                        Requested Budget: <strong>$@Evaluation.RequestedBudget.Value.ToString("N0")</strong>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="glass-card h-100">
                <h5 class="font-weight-bold mb-3 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-chart-column text-indigo-400"></i> Dimensional Sub-Score Analysis
                </h5>

                <div class="row g-3">
                    @foreach (var dim in Evaluation.DimensionalScores)
                    {
                        <div class="col-md-4">
                            <div class="p-3 border-radius-12" style="background-color: var(--bg-input); border-radius: 12px; border: 1px solid var(--border-color);">
                                <div class="small font-weight-semibold text-secondary mb-1">@dim.Name</div>
                                <div class="display-6 font-weight-extrabold" style="color: @dim.StatusColor">
                                    @dim.Score.ToString("F1")
                                </div>
                                <div class="small text-muted mt-1" style="font-size: 0.8rem; line-height: 1.4;">
                                    @dim.Description
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Uncertainty Confidence Interval -->
    <UncertaintyBand Confidence="@Evaluation.Confidence" />

    <!-- XAI TreeSHAP Explanation Chart -->
    <ShapExplanationChart Features="@Evaluation.ShapExplanations" />

    <!-- GenAI Narrative Card -->
    <GenAiNarrativeCard Narrative="@Evaluation.Narrative" />
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private EvaluationResult? Evaluation;

    protected override async Task OnParametersSetAsync()
    {
        Evaluation = await EvaluationService.GetEvaluationByIdAsync(Id);
    }

    private async Task DownloadReport()
    {
        if (Evaluation == null) return;
        var pdfBytes = await EvaluationService.DownloadPdfReportAsync(Evaluation.Id);
        var base64 = Convert.ToBase64String(pdfBytes);
        var safeFilename = $"{Evaluation.ProposalTitle.Replace(" ", "_")}_Evaluation_Report.pdf";
        await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", safeFilename, base64);
    }
}
