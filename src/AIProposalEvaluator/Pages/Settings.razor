@page "/settings"
@using frontend.Services
@inject IEvaluationService EvaluationService

<div class="mb-4">
    <h3 class="font-weight-extrabold mb-1">System Configuration & Integration</h3>
    <p class="text-secondary small mb-0">Manage backend API endpoints, connection settings, and system execution mode</p>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="glass-card mb-4">
            <h5 class="font-weight-bold mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-server text-indigo-400"></i> Backend API Connection Mode
            </h5>

            <div class="form-check form-switch p-3 mb-3 border-radius-10" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: 10px;">
                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="mockModeSwitch"
                       checked="@EvaluationService.UseMockMode"
                       @onchange="ToggleMockMode" style="width: 45px; height: 24px; cursor: pointer;" />
                <label class="form-check-label font-weight-bold" for="mockModeSwitch" style="cursor: pointer;">
                    Enable Standalone Mock Engine
                </label>
                <div class="small text-secondary mt-1">
                    When enabled, the frontend runs independently using realistic simulated ML scores, XAI SHAP explanations, and GenAI narratives without requiring Python server background execution.
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small font-weight-bold text-secondary">FastAPI REST Backend Base URL</label>
                <div class="input-group">
                    <input type="text" class="form-control-custom" @bind="EndpointUrl" placeholder="http://localhost:8000" disabled="@EvaluationService.UseMockMode" />
                    <button class="btn-secondary" @onclick="TestConnection" disabled="@EvaluationService.UseMockMode">
                        <i class="fa-solid fa-plug me-1"></i> Test Endpoint
                    </button>
                </div>
            </div>

            @if (TestResultHasRun)
            {
                <div class="alert @(TestSuccess ? "alert-success" : "alert-danger") small mb-0" style="border-radius: 10px;">
                    <i class="@(TestSuccess ? "fa-solid fa-circle-check" : "fa-solid fa-circle-xmark") me-2"></i>
                    @(TestSuccess ? $"Successfully connected to FastAPI server at {EndpointUrl}" : $"Failed to connect to FastAPI endpoint at {EndpointUrl}. Is the Python backend server running?")
                </div>
            }
        </div>

        <div class="glass-card">
            <h5 class="font-weight-bold mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-list-check text-emerald-400"></i> Member 1 Requirement Checklist
            </h5>
            <div class="d-flex flex-column gap-2">
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span>Blazor WASM Architecture (Pages & Components)</span>
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span>Dashboard with Past Evaluations & Metrics</span>
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span>Proposal Upload Form with Real-Time Loading States</span>
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span>Custom Styling & CSS in wwwroot/ (Dark/Light Modes)</span>
                </div>
                <div class="d-flex align-items-center gap-2 small">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i>
                    <span>Responsive & Accessible Modern UI Layout</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="glass-card">
            <h5 class="font-weight-bold mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-info text-cyan-400"></i> Project Architecture Reference
            </h5>
            <div class="small text-secondary d-flex flex-column gap-2">
                <p><strong>System Name:</strong> AI-Driven Proposal Evaluation & Explainability Suite</p>
                <p><strong>Frontend Technology:</strong> Blazor WebAssembly (.NET 10.0)</p>
                <p><strong>Backend API Target:</strong> FastAPI + Uvicorn (REST API)</p>
                <p><strong>Key Requirements Met:</strong></p>
                <ul class="mb-0 ps-3">
                    <li>FR-1: PDF Upload & Ingestion</li>
                    <li>FR-4: ML Ensemble Scoring (0-100)</li>
                    <li>FR-5: Uncertainty Confidence Band</li>
                    <li>FR-6: TreeSHAP Feature Attributions</li>
                    <li>FR-7: GenAI Narrative Summary</li>
                    <li>FR-8: Downloadable PDF Reports</li>
                    <li>FR-9: Dashboard & Timeline History</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private string EndpointUrl = "http://localhost:8000";
    private bool TestResultHasRun = false;
    private bool TestSuccess = false;

    protected override void OnInitialized()
    {
        EndpointUrl = EvaluationService.ApiEndpoint;
    }

    private void ToggleMockMode(ChangeEventArgs e)
    {
        if (e.Value is bool isChecked)
        {
            EvaluationService.UseMockMode = isChecked;
            TestResultHasRun = false;
        }
    }

    private async Task TestConnection()
    {
        EvaluationService.ApiEndpoint = EndpointUrl;
        TestSuccess = await EvaluationService.TestApiConnectionAsync();
        TestResultHasRun = true;
    }
}
