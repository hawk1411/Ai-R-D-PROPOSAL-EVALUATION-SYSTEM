@page "/evaluate"
@using frontend.Models
@using frontend.Services
@inject NavigationManager NavigationManager

<div class="mb-4 d-flex align-items-center justify-content-between">
    <div>
        <h3 class="font-weight-extrabold mb-1">Evaluate New Research Proposal</h3>
        <p class="text-secondary small mb-0">Upload a proposal PDF and optional budget amount to initiate automated AI scoring</p>
    </div>
    @if (CompletedResult != null)
    {
        <button class="btn-secondary" @onclick="ResetToForm">
            <i class="fa-solid fa-plus me-1"></i> Evaluate Another Proposal
        </button>
    }
</div>

@if (CompletedResult != null)
{
    <!-- Instant Evaluation Result View -->
    <div class="alert alert-success d-flex align-items-center justify-content-between mb-4 p-3" style="background-color: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.3); color: #34D399; border-radius: 12px;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-circle-check fs-4"></i>
            <div>
                <strong>Evaluation Completed Successfully!</strong>
                <div class="small">Score generated for '@CompletedResult.ProposalTitle'</div>
            </div>
        </div>
        <button class="btn-primary py-1 px-3" @onclick="GoToDetails">
            <i class="fa-solid fa-arrow-right"></i> View Full Detailed Report
        </button>
    </div>

    <!-- Summary Preview Card -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4 text-center">
            <div class="glass-card h-100 d-flex flex-column align-items-center justify-content-center">
                <ScoreGauge Score="@CompletedResult.OverallScore" />
                <h5 class="mt-3 font-weight-bold">Overall AI Score</h5>
                <span class="badge-pill badge-emerald mt-1">@CompletedResult.ScoreTier</span>
            </div>
        </div>
        <div class="col-lg-8">
            <UncertaintyBand Confidence="@CompletedResult.Confidence" />
        </div>
    </div>

    <ShapExplanationChart Features="@CompletedResult.ShapExplanations" />
    <GenAiNarrativeCard Narrative="@CompletedResult.Narrative" />
}
else
{
    <ProposalUploadForm OnEvaluationCompleted="@HandleEvaluationCompleted" />
}

@code {
    private EvaluationResult? CompletedResult;

    private void HandleEvaluationCompleted(EvaluationResult result)
    {
        CompletedResult = result;
        StateHasChanged();
    }

    private void ResetToForm()
    {
        CompletedResult = null;
    }

    private void GoToDetails()
    {
        if (CompletedResult != null)
        {
            NavigationManager.NavigateTo($"/evaluation/{CompletedResult.Id}");
        }
    }
}
