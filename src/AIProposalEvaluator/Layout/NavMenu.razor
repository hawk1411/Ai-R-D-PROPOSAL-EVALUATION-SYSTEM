@using frontend.Services
@inject IEvaluationService EvaluationService

<div class="brand-header">
    <div class="brand-icon">
        <i class="fa-solid fa-brain"></i>
    </div>
    <div>
        <div class="brand-title">AI Proposal Suite</div>
        <div class="brand-subtitle">Decision Support System</div>
    </div>
</div>

<div class="nav-links">
    <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All">
        <i class="fa-solid fa-chart-pie fs-5"></i>
        <span class="nav-text">Dashboard</span>
    </NavLink>

    <NavLink class="nav-item-link" href="evaluate">
        <i class="fa-solid fa-file-circle-plus fs-5"></i>
        <span class="nav-text">Evaluate Proposal</span>
    </NavLink>

    <NavLink class="nav-item-link" href="history">
        <i class="fa-solid fa-clock-rotate-left fs-5"></i>
        <span class="nav-text">Evaluation History</span>
    </NavLink>

    <NavLink class="nav-item-link" href="settings">
        <i class="fa-solid fa-sliders fs-5"></i>
        <span class="nav-text">System Settings</span>
    </NavLink>
</div>

<div class="mt-auto p-3 m-2 border-radius-12" style="background-color: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="spinner-grow spinner-grow-sm text-emerald-400" role="status" style="width: 8px; height: 8px;"></span>
        <span class="small font-weight-bold text-light">System Mode</span>
    </div>
    <div class="small text-muted mb-2">
        @(EvaluationService.UseMockMode ? "Standalone Mock Engine" : "Live FastAPI Backend")
    </div>
    <NavLink href="settings" class="small text-indigo-400 font-weight-semibold text-decoration-none">
        Configure API <i class="fa-solid fa-arrow-right ms-1"></i>
    </NavLink>
</div>
