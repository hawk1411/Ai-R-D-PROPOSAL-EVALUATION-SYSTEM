@inherits LayoutComponentBase
@using frontend.Services
@inject ThemeService ThemeService
@inject IEvaluationService EvaluationService

<div class="app-container">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="main-content">
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <h5 class="mb-0 font-weight-bold d-none d-md-block">AI-Driven R&D Evaluation Suite</h5>
                <span class="badge-pill badge-indigo">
                    <i class="fa-solid fa-microchip"></i> Blazor WASM UI
                </span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- System Connection Status Pill -->
                <div class="d-none d-sm-flex align-items-center gap-2 px-3 py-1 border-radius-20" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: 20px; font-size: 0.825rem;">
                    @if (EvaluationService.UseMockMode)
                    {
                        <i class="fa-solid fa-flask text-amber-400"></i>
                        <span class="text-secondary">Mock Data Engine</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-server text-emerald-400"></i>
                        <span class="text-secondary">FastAPI: @EvaluationService.ApiEndpoint</span>
                    }
                </div>

                <!-- Theme Toggle Button -->
                <button class="btn-secondary py-1 px-3" @onclick="ToggleTheme" title="Toggle Light / Dark Mode">
                    @if (ThemeService.IsDarkMode)
                    {
                        <i class="fa-solid fa-sun text-amber-400 me-1"></i> <span>Light</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-moon text-indigo-400 me-1"></i> <span>Dark</span>
                    }
                </button>
            </div>
        </header>

        <div class="page-container">
            @Body
        </div>
    </main>
</div>

@code {
    private bool _initialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            ThemeService.OnThemeChanged += StateHasChanged;
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }
}
