@using frontend.Models

<div class="glass-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-chart-line text-indigo-400 fs-5"></i>
            <h5 class="mb-0">Prediction Uncertainty & Confidence Band (FR-5)</h5>
        </div>
        <span class="badge-pill badge-indigo">
            <i class="fa-solid fa-shield-halved"></i> @(Confidence?.ConfidenceLevelPercentage ?? 95)% Confidence Interval
        </span>
    </div>

    @if (Confidence != null)
    {
        <div class="row align-items-center g-3 mb-3">
            <div class="col-md-4 text-center text-md-start">
                <div class="text-secondary small font-weight-bold">MEAN ESTIMATED SCORE</div>
                <div class="display-6 font-weight-extrabold text-indigo-400">@Confidence.MeanScore.ToString("F1")</div>
                <div class="small text-muted">Std Dev: ±@Confidence.StdDeviation.ToString("F1") points</div>
            </div>
            <div class="col-md-8">
                <div class="d-flex justify-content-between small text-secondary mb-1">
                    <span>Lower Bound (95%): <strong>@Confidence.LowerBound.ToString("F1")</strong></span>
                    <span>Upper Bound (95%): <strong>@Confidence.UpperBound.ToString("F1")</strong></span>
                </div>
                <!-- Visual Confidence Band Bar -->
                <div style="position: relative; height: 32px; background-color: var(--bg-input); border-radius: 10px; overflow: hidden; border: 1px solid var(--border-color);">
                    <!-- 95% Confidence Interval Highlight Band -->
                    <div style="position: absolute; top: 0; bottom: 0; left: @(Math.Clamp(Confidence.LowerBound, 0, 100))%; width: @(Math.Clamp(Confidence.UpperBound - Confidence.LowerBound, 2, 100))%; background: linear-gradient(90deg, rgba(99, 102, 241, 0.3) 0%, rgba(139, 92, 246, 0.4) 100%); border-left: 2px solid #818CF8; border-right: 2px solid #818CF8;"></div>
                    <!-- Mean Point Indicator -->
                    <div style="position: absolute; top: 0; bottom: 0; left: calc(@(Math.Clamp(Confidence.MeanScore, 0, 100))% - 2px); width: 4px; background-color: #6366F1; box-shadow: 0 0 10px #6366F1;" title="Mean Score: @Confidence.MeanScore"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted mt-1">
                    <span>0 (High Uncertainty Risk)</span>
                    <span>50</span>
                    <span>100 (High Certainty Quality)</span>
                </div>
            </div>
        </div>

        <div class="p-3 border-radius-10" style="background-color: var(--bg-input); border: 1px solid var(--border-color); border-radius: 10px;">
            <div class="d-flex align-items-start gap-2">
                <i class="fa-solid fa-circle-info text-cyan-400 mt-1"></i>
                <div class="small">
                    <strong>Model Variance Interpretation:</strong> @Confidence.Interpretation
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public ConfidenceInterval? Confidence { get; set; }
}
