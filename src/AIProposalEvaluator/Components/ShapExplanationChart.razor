@using frontend.Models

<div class="glass-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-brain text-emerald-400 fs-5"></i>
                <h5 class="mb-0">Explainable AI (XAI) - TreeSHAP Feature Attributions (FR-6)</h5>
            </div>
            <p class="small text-secondary mb-0 mt-1">Local feature contribution towards final overall score prediction (+ positive boost / - negative penalty)</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge-pill badge-emerald"><i class="fa-solid fa-plus"></i> Positive Driver</span>
            <span class="badge-pill badge-rose"><i class="fa-solid fa-minus"></i> Negative Factor</span>
        </div>
    </div>

    @if (Features != null && Features.Any())
    {
        <div class="shap-chart-wrapper my-3">
            @foreach (var feature in Features.OrderByDescending(f => Math.Abs(f.ImpactScore)))
            {
                var absScore = Math.Abs(feature.ImpactScore);
                var maxScore = 20.0;
                var percentage = Math.Clamp((absScore / maxScore) * 100.0, 5, 100);

                <div class="shap-bar-row">
                    <div class="shap-feature-name" title="@feature.FeatureName - @feature.Description">
                        <i class="@(feature.IsPositive ? "fa-solid fa-circle-check text-emerald-400" : "fa-solid fa-circle-exclamation text-rose-400") me-1"></i>
                        @feature.FeatureName
                    </div>
                    <div class="shap-bar-track">
                        <div class="shap-bar-fill @(feature.IsPositive ? "shap-bar-positive" : "shap-bar-negative")"
                             style="width: @(percentage.ToString("F1"))%;"></div>
                    </div>
                    <div class="shap-val-badge @(feature.IsPositive ? "positive" : "negative")">
                        @(feature.IsPositive ? "+" : "")@feature.ImpactScore.ToString("F1")
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-chart-bar fs-2 mb-2"></i>
            <p>No SHAP feature attribution data available for this evaluation.</p>
        </div>
    }
</div>

@code {
    [Parameter] public List<ShapFeature>? Features { get; set; }
}
