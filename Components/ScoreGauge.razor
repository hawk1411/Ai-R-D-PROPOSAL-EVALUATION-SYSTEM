@using frontend.Models

<div class="gauge-container">
    <svg class="gauge-svg" width="180" height="180" viewBox="0 0 180 180">
        <circle class="gauge-bg" cx="90" cy="90" r="70" />
        <circle class="gauge-fill" cx="90" cy="90" r="70"
                stroke="@ScoreColor"
                stroke-dasharray="@Circumference"
                stroke-dashoffset="@DashOffset" />
    </svg>
    <div class="gauge-center-text">
        <div class="gauge-score-num" style="color: @ScoreColor">@Score.ToString("F1")</div>
        <div class="gauge-score-label">@ScoreLabel</div>
    </div>
</div>

@code {
    [Parameter] public double Score { get; set; }

    private double Radius = 70;
    private double Circumference => 2 * Math.PI * Radius;
    private double DashOffset => Circumference - (Math.Clamp(Score, 0, 100) / 100.0) * Circumference;

    private string ScoreColor => Score switch
    {
        >= 75.0 => "#10B981", // Emerald
        >= 50.0 => "#F59E0B", // Amber
        _ => "#EF4444"        // Red
    };

    private string ScoreLabel => Score switch
    {
        >= 80.0 => "High Potential",
        >= 65.0 => "Moderate",
        >= 50.0 => "Borderline",
        _ => "High Risk"
    };
}
