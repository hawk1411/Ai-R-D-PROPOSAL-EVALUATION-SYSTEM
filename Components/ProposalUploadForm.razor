@using Microsoft.AspNetCore.Components.Forms
@using frontend.Models
@using frontend.Services
@inject IEvaluationService EvaluationService
@implements IDisposable


<div class="glass-card">
    <div class="d-flex align-items-center gap-3 mb-4 border-bottom pb-3" style="border-color: var(--border-color) !important;">
        <div class="metric-icon-box metric-icon-indigo">
            <i class="fa-solid fa-file-arrow-up"></i>
        </div>
        <div>
            <h4 class="mb-0">Upload Proposal PDF for AI Evaluation</h4>
            <span class="small text-secondary">Accepted format: PDF (.pdf up to 50MB). Budget amount is optional but recommended.</span>
        </div>
    </div>

    @if (IsProcessing)
    {
        <div class="py-4">
            <div class="text-center mb-4">
                <div class="spinner-dot mx-auto mb-3" style="width: 45px; height: 45px; border-width: 4px; border-top-color: var(--accent-primary);"></div>
                <h5 class="text-indigo-400 font-weight-bold">Evaluating Proposal Pipeline...</h5>
                <p class="small text-secondary">Running machine learning ensemble, SHAP explainability, and GenAI narrative engine</p>
            </div>

            <!-- Pipeline Progress Stepper (12 Stages) -->
            <div class="pipeline-stepper">
                @foreach (var stage in PipelineStages)
                {
                    <div class="pipeline-step-item @(stage.IsCurrent ? "active" : "") @(stage.IsCompleted ? "completed" : "")">
                        <div class="step-number-pill">
                            @if (stage.IsCompleted)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else if (stage.IsCurrent)
                            {
                                <div class="spinner-dot" style="width: 14px; height: 14px;"></div>
                            }
                            else
                            {
                                @stage.StageNumber
                            }
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between">
                                <strong class="small font-weight-bold">@stage.StageName</strong>
                                @if (stage.IsCurrent)
                                {
                                    <span class="badge-pill badge-indigo">Processing</span>
                                }
                            </div>
                            <div class="small text-muted" style="font-size: 0.8rem;">@stage.Description</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <EditForm Model="@UploadModel" OnValidSubmit="@HandleFormSubmit">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3); color: #F87171;">
                    <i class="fa-solid fa-circle-exclamation fs-5"></i>
                    <div>@ErrorMessage</div>
                </div>
            }

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label class="form-label small font-weight-bold text-secondary">Proposal Title <span class="text-rose-400">*</span></label>
                    <InputText @bind-Value="UploadModel.Title" class="form-control-custom" placeholder="e.g. Next-Generation Quantum Solid State Battery Architecture" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small font-weight-bold text-secondary">Research Category</label>
                    <InputSelect @bind-Value="UploadModel.Category" class="form-control-custom">
                        <option value="Artificial Intelligence">Artificial Intelligence & ML</option>
                        <option value="Quantum Computing & Security">Quantum Computing & Security</option>
                        <option value="Biotechnology & Agriculture">Biotechnology & Agriculture</option>
                        <option value="Clean Energy & Storage">Clean Energy & Storage</option>
                        <option value="Aerospace & Robotics">Aerospace & Robotics</option>
                        <option value="General R&D">General R&D Innovation</option>
                    </InputSelect>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label small font-weight-bold text-secondary">Principal Investigator (PI)</label>
                    <InputText @bind-Value="UploadModel.PrincipalInvestigator" class="form-control-custom" placeholder="e.g. Dr. Jane Doe" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small font-weight-bold text-secondary">Institution / Organization</label>
                    <InputText @bind-Value="UploadModel.Institution" class="form-control-custom" placeholder="e.g. Stanford University / Research Lab" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small font-weight-bold text-secondary">
                    Requested Budget ($ USD) <span class="badge-pill badge-indigo ms-1">Recommended for Financial Check (FR-3)</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <InputNumber @bind-Value="UploadModel.Budget" class="form-control-custom" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="e.g. 450000" />
                </div>
                <div class="form-text small text-muted mt-1">If budget is omitted, overall score is computed but financial realism assessment is bypassed.</div>
            </div>

            <!-- PDF File Drag & Drop Zone -->
            <div class="mb-4">
                <label class="form-label small font-weight-bold text-secondary">Proposal Document PDF <span class="text-rose-400">*</span></label>
                
                <div class="upload-dropzone @(IsDragOver ? "dragover" : "")"
                     @ondragover="HandleDragOver"
                     @ondragleave="HandleDragLeave">
                    
                    <InputFile OnChange="@HandleFileSelected" accept=".pdf" class="d-none" id="fileUploadInput" />
                    
                    <label for="fileUploadInput" style="cursor: pointer; width: 100%; height: 100%; display: block; margin-bottom: 0;">
                        <div class="upload-icon-circle">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </div>
                        @if (SelectedFile != null)
                        {
                            <h5 class="text-emerald-400 font-weight-bold mb-1">
                                <i class="fa-solid fa-file-pdf me-2"></i>@SelectedFile.Name
                            </h5>
                            <span class="badge-pill badge-emerald">@((SelectedFile.Size / 1024.0 / 1024.0).ToString("F2")) MB - Ready for Ingestion</span>
                        }
                        @if (SelectedFile == null)
                        {
                            <h5 class="font-weight-bold mb-1">Drag and drop your Proposal PDF here</h5>
                            <p class="small text-secondary mb-2">or click to browse files on your device</p>
                            <span class="badge-pill badge-indigo">Supports PDF format (Max 50MB)</span>
                        }
                    </label>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 pt-3 border-top" style="border-color: var(--border-color) !important;">
                <button type="button" class="btn-secondary" @onclick="@ResetForm">
                    <i class="fa-solid fa-rotate-left"></i> Reset Form
                </button>
                <button type="submit" class="btn-primary" disabled="@(SelectedFile == null || string.IsNullOrWhiteSpace(UploadModel.Title))">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Run AI Evaluation Pipeline
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public EventCallback<EvaluationResult> OnEvaluationCompleted { get; set; }

    private ProposalEvaluationRequest UploadModel = new();
    private IBrowserFile? SelectedFile;
    private bool IsDragOver = false;
    private bool IsProcessing = false;
    private string ErrorMessage = string.Empty;

    private List<PipelineStageProgress> PipelineStages = new();

    protected override void OnInitialized()
    {
        EvaluationService.OnPipelineProgress += HandlePipelineProgress;
    }

    private void HandleDragOver() => IsDragOver = true;
    private void HandleDragLeave() => IsDragOver = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
        ErrorMessage = string.Empty;

        if (SelectedFile != null)
        {
            if (!SelectedFile.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                ErrorMessage = "Invalid file type. Please upload a PDF (.pdf) file.";
                SelectedFile = null;
                return;
            }

            if (SelectedFile.Size > 50 * 1024 * 1024)
            {
                ErrorMessage = "File size exceeds limit (50MB maximum).";
                SelectedFile = null;
                return;
            }

            UploadModel.FileName = SelectedFile.Name;
            UploadModel.FileSizeBytes = SelectedFile.Size;

            if (string.IsNullOrWhiteSpace(UploadModel.Title))
            {
                // Auto-generate title from filename
                var baseName = System.IO.Path.GetFileNameWithoutExtension(SelectedFile.Name);
                UploadModel.Title = baseName.Replace("_", " ").Replace("-", " ");
            }

            // Read file bytes into memory
            using var stream = SelectedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            using var ms = new System.IO.MemoryStream();
            await stream.CopyToAsync(ms);
            UploadModel.FileContent = ms.ToArray();
        }
    }

    private void HandlePipelineProgress(PipelineStageProgress stage)
    {
        var existing = PipelineStages.FirstOrDefault(s => s.StageNumber == stage.StageNumber);
        if (existing != null)
        {
            existing.IsCurrent = stage.IsCurrent;
            existing.IsCompleted = stage.IsCompleted;
        }
        else
        {
            PipelineStages.Add(stage);
        }
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleFormSubmit()
    {
        if (SelectedFile == null)
        {
            ErrorMessage = "Please select a proposal PDF file before submitting.";
            return;
        }

        IsProcessing = true;
        ErrorMessage = string.Empty;
        PipelineStages.Clear();

        try
        {
            var result = await EvaluationService.SubmitEvaluationAsync(UploadModel);
            IsProcessing = false;
            await OnEvaluationCompleted.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            IsProcessing = false;
            ErrorMessage = $"Error during evaluation pipeline: {ex.Message}";
        }
    }

    private void ResetForm()
    {
        UploadModel = new ProposalEvaluationRequest();
        SelectedFile = null;
        ErrorMessage = string.Empty;
        IsProcessing = false;
        PipelineStages.Clear();
    }

    public void Dispose()
    {
        EvaluationService.OnPipelineProgress -= HandlePipelineProgress;
    }
}
