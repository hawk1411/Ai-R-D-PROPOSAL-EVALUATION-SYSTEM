@using frontend.Models
@using frontend.Services
@inject IEvaluationService EvaluationService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<div class="glass-card">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h5 class="mb-0 font-weight-bold">Evaluation History & Timeline (FR-9)</h5>
            <span class="small text-secondary">Browse, filter, and inspect past AI evaluated proposals</span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <!-- Search input -->
            <div class="input-group" style="max-width: 250px;">
                <span class="input-group-text border-0" style="background-color: var(--bg-input); color: var(--text-muted); border: 1px solid var(--border-color) !important; border-right: none !important;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" class="form-control-custom" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="Search title or PI..." @bind="SearchQuery" @bind:event="oninput" />
            </div>

            <!-- Category filter -->
            <select class="form-control-custom" style="max-width: 180px;" @bind="SelectedCategory">
                <option value="">All Categories</option>
                <option value="Artificial Intelligence">AI & ML</option>
                <option value="Quantum Computing & Security">Quantum</option>
                <option value="Biotechnology & Agriculture">Biotech</option>
                <option value="Clean Energy & Storage">Clean Energy</option>
                <option value="Aerospace & Data Science">Aerospace</option>
            </select>

            <!-- Score tier filter -->
            <select class="form-control-custom" style="max-width: 160px;" @bind="SelectedScoreTier">
                <option value="">All Scores</option>
                <option value="Tier 1">Tier 1 (≥75)</option>
                <option value="Tier 2">Tier 2 (60-74)</option>
                <option value="Tier 3">Tier 3 (Under 60)</option>
            </select>
        </div>
    </div>

    @if (FilteredEvaluations == null)
    {
        <div class="text-center py-4 text-muted">
            <div class="spinner-dot mx-auto mb-2"></div>
            <span>Loading past evaluations...</span>
        </div>
    }
    else if (!FilteredEvaluations.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-folder-open fs-1 mb-3 text-secondary"></i>
            <h5>No proposal evaluations found</h5>
            <p class="small">Try adjusting search filters or upload a new proposal PDF.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th @onclick='() => Sort("title")' style="cursor: pointer;">Proposal Title <i class="fa-solid fa-sort small ms-1"></i></th>
                        <th>Category</th>
                        <th>Investigator</th>
                        <th @onclick='() => Sort("score")' style="cursor: pointer;">Overall Score <i class="fa-solid fa-sort small ms-1"></i></th>
                        <th>Budget ($)</th>
                        <th @onclick='() => Sort("date")' style="cursor: pointer;">Date <i class="fa-solid fa-sort small ms-1"></i></th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evalItem in FilteredEvaluations)
                    {
                        <tr>
                            <td>
                                <div class="font-weight-bold text-truncate" style="max-width: 280px;" title="@evalItem.ProposalTitle">
                                    @evalItem.ProposalTitle
                                </div>
                                <div class="small text-muted d-flex align-items-center gap-1">
                                    <i class="fa-solid fa-file-pdf text-rose-400"></i> @evalItem.FileName
                                </div>
                            </td>
                            <td>
                                <span class="badge-pill badge-indigo">@evalItem.Category</span>
                            </td>
                            <td>
                                <div class="small font-weight-semibold">@evalItem.PrincipalInvestigator</div>
                                <div class="small text-muted">@evalItem.Institution</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="font-weight-extrabold fs-6" style="color: @GetScoreColor(evalItem.OverallScore)">
                                        @evalItem.OverallScore.ToString("F1")
                                    </span>
                                    <span class="badge-pill @GetScoreBadgeClass(evalItem.OverallScore)">
                                        @evalItem.ScoreTier.Split('-').FirstOrDefault()
                                    </span>
                                </div>
                            </td>
                            <td>
                                @if (evalItem.RequestedBudget.HasValue)
                                {
                                    <span class="font-weight-medium">$@evalItem.RequestedBudget.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">N/A</span>
                                }
                            </td>
                            <td>
                                <div class="small text-secondary">@evalItem.EvaluatedAt.ToString("MMM dd, yyyy")</div>
                                <div class="small text-muted">@evalItem.EvaluatedAt.ToString("HH:mm") UTC</div>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn-secondary py-1 px-2 text-indigo-400" @onclick="() => InspectEvaluation(evalItem.Id)" title="View Detailed Report">
                                        <i class="fa-solid fa-eye"></i> View
                                    </button>
                                    <button class="btn-secondary py-1 px-2 text-emerald-400" @onclick="() => DownloadReport(evalItem.Id, evalItem.ProposalTitle)" title="Download PDF Report">
                                        <i class="fa-solid fa-file-pdf"></i> PDF
                                    </button>
                                    <button class="btn-secondary py-1 px-2 text-rose-400" @onclick="() => DeleteEvaluation(evalItem.Id)" title="Delete Record">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public List<EvaluationResult>? Evaluations { get; set; }
    [Parameter] public EventCallback OnDataChanged { get; set; }

    private string SearchQuery = string.Empty;
    private string SelectedCategory = string.Empty;
    private string SelectedScoreTier = string.Empty;
    private string SortColumn = "date";
    private bool SortAscending = false;

    private IEnumerable<EvaluationResult>? FilteredEvaluations
    {
        get
        {
            if (Evaluations == null) return null;

            var items = Evaluations.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(SearchQuery))
            {
                items = items.Where(e => e.ProposalTitle.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         e.PrincipalInvestigator.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         e.Institution.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                items = items.Where(e => e.Category.Equals(SelectedCategory, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedScoreTier))
            {
                if (SelectedScoreTier == "Tier 1") items = items.Where(e => e.OverallScore >= 75.0);
                else if (SelectedScoreTier == "Tier 2") items = items.Where(e => e.OverallScore >= 60.0 && e.OverallScore < 75.0);
                else if (SelectedScoreTier == "Tier 3") items = items.Where(e => e.OverallScore < 60.0);
            }

            items = SortColumn switch
            {
                "title" => SortAscending ? items.OrderBy(e => e.ProposalTitle) : items.OrderByDescending(e => e.ProposalTitle),
                "score" => SortAscending ? items.OrderBy(e => e.OverallScore) : items.OrderByDescending(e => e.OverallScore),
                "date" => SortAscending ? items.OrderBy(e => e.EvaluatedAt) : items.OrderByDescending(e => e.EvaluatedAt),
                _ => items
            };

            return items;
        }
    }

    private void Sort(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = false;
        }
    }

    private void InspectEvaluation(string id)
    {
        NavigationManager.NavigateTo($"/evaluation/{id}");
    }

    private async Task DownloadReport(string id, string title)
    {
        var pdfBytes = await EvaluationService.DownloadPdfReportAsync(id);
        var base64 = Convert.ToBase64String(pdfBytes);
        var safeFilename = $"{title.Replace(" ", "_")}_Evaluation_Report.pdf";
        await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", safeFilename, base64);
    }

    private async Task DeleteEvaluation(string id)
    {
        await EvaluationService.DeleteEvaluationAsync(id);
        await OnDataChanged.InvokeAsync();
    }

    private string GetScoreColor(double score) => score switch
    {
        >= 75.0 => "#10B981",
        >= 60.0 => "#F59E0B",
        _ => "#EF4444"
    };

    private string GetScoreBadgeClass(double score) => score switch
    {
        >= 75.0 => "badge-emerald",
        >= 60.0 => "badge-amber",
        _ => "badge-rose"
    };
}
