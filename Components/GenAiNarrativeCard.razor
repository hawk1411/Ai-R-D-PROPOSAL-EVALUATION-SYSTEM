@using frontend.Models

<div class="glass-card mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-3" style="border-color: var(--border-color) !important;">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-wand-magic-sparkles text-amber-400 fs-4"></i>
            <div>
                <h5 class="mb-0">GenAI Executive Evaluation Narrative (FR-7)</h5>
                <span class="small text-muted">Automated narrative summary generated by LLM pipeline</span>
            </div>
        </div>
        <span class="badge-pill @RecommendationBadgeClass">
            <i class="fa-solid fa-award"></i> @(Narrative?.FinalRecommendation ?? "Under Review")
        </span>
    </div>

    @if (Narrative != null)
    {
        <!-- Executive Summary -->
        <div class="mb-4 p-3 border-radius-12" style="background-color: var(--bg-input); border-left: 4px solid var(--accent-primary); border-radius: 8px;">
            <h6 class="text-indigo-400 mb-2 font-weight-bold"><i class="fa-solid fa-align-left me-1"></i> Executive Narrative Summary</h6>
            <p class="mb-0 text-secondary" style="font-size: 0.95rem; line-height: 1.7;">@Narrative.ExecutiveSummary</p>
        </div>

        <div class="row g-3 mb-4">
            <!-- Key Strengths -->
            <div class="col-md-6">
                <div class="p-3 border-radius-12 h-100" style="background-color: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 12px;">
                    <h6 class="text-emerald-400 font-weight-bold mb-3"><i class="fa-solid fa-thumbs-up me-1"></i> Key Technical Strengths</h6>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        @foreach (var strength in Narrative.KeyStrengths)
                        {
                            <li class="d-flex align-items-start gap-2 small text-secondary">
                                <i class="fa-solid fa-check text-emerald-400 mt-1"></i>
                                <span>@strength</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Identified Risks -->
            <div class="col-md-6">
                <div class="p-3 border-radius-12 h-100" style="background-color: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 12px;">
                    <h6 class="text-rose-400 font-weight-bold mb-3"><i class="fa-solid fa-triangle-exclamation me-1"></i> Technical & Operational Risks</h6>
                    <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                        @foreach (var risk in Narrative.IdentifiedRisks)
                        {
                            <li class="d-flex align-items-start gap-2 small text-secondary">
                                <i class="fa-solid fa-xmark text-rose-400 mt-1"></i>
                                <span>@risk</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Financial & Budget Assessment -->
        <div class="p-3 border-radius-12 mb-3" style="background-color: var(--bg-input); border-radius: 10px;">
            <h6 class="text-cyan-400 font-weight-bold mb-1"><i class="fa-solid fa-calculator me-1"></i> Financial Realism Assessment</h6>
            <p class="small text-secondary mb-0">@Narrative.BudgetAssessment</p>
        </div>

        @if (!string.IsNullOrEmpty(Narrative.AuditNotes))
        {
            <div class="small text-muted border-top pt-2 mt-2" style="border-color: var(--border-color) !important;">
                <i class="fa-solid fa-shield me-1"></i> <strong>Audit Verification Trail:</strong> @Narrative.AuditNotes
            </div>
        }
    }
</div>

@code {
    [Parameter] public GenAiNarrative? Narrative { get; set; }

    private string RecommendationBadgeClass => Narrative?.FinalRecommendation switch
    {
        var r when r != null && r.Contains("High") || r != null && r.Contains("Immediate") => "badge-emerald",
        var r when r != null && r.Contains("Conditional") || r != null && r.Contains("Revision") => "badge-amber",
        _ => "badge-indigo"
    };
}
